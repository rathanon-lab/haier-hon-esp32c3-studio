# ESP32-C3 Haier AC Studio v4.1 — Example Configuration
# Set credentials directly inside the Web UI (⚙️ System -> Wi-Fi & BLE)
# or update default constants in firmware/p25_haier_c3/p25_haier_c3.ino before first flash.

PRIMARY_WIFI_SSID="YOUR_PRIMARY_WIFI_SSID"
PRIMARY_WIFI_PASS="YOUR_PRIMARY_WIFI_PASS"
BACKUP_WIFI_SSID="YOUR_BACKUP_WIFI_SSID"
BACKUP_WIFI_PASS="YOUR_BACKUP_WIFI_PASS"
STATIC_IP_SUFFIX="25"
OTA_PASSWORD="CHANGE_ME_OTA_PASS"
XIAOMI_BLE_MAC="aa:bb:cc:dd:ee:ff"
UART_RX_PIN="4"
UART_TX_PIN="3"
PEA_TARIFF_TYPE="1.1.2"
PEA_FT_SATANG="16.23"
